{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WritePortalReportBucket",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::portal-report.concord.org/*"
    },
    {
      "Sid": "ListPortalReportBucketForSync",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::portal-report.concord.org"
    }
  ]
}
